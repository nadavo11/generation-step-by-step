---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
import { withBase } from '../utils/paths';
const lead = projects[0];
---
<Base title="Research projects" description="Image generation research, visual evidence, caveats, and next experiments.">
  <div class="home-shell shell">
    <section class="home-hero">
      <p class="section-overline">Research collection / one study</p>
      <h1>How images <em>take shape.</em></h1>
      <p>Tracing when structure and detail appear in generative models, from checkpoint trajectories to matched experiments.</p>
      {lead && <a class="text-link" href={withBase('projects/' + lead.slug + '/')}>Explore the first study <span aria-hidden="true">↗</span></a>}
    </section>

    <section id="projects" class="home-projects">
      <div class="home-section-top"><h2>Studies</h2><span>{String(projects.length).padStart(2, '0')} / growing collection</span></div>
      {projects.map((project) => <article class="home-feature">
        <a class="home-feature-visual" href={withBase('projects/' + project.slug + '/')} aria-label={'Open ' + project.title}>
          <img src={withBase('ours/ffhq64-a1-d256/a1-grid-146k.png')} alt="A1 D256 FFHQ-64 generated sample grid at 146k steps" loading="lazy" />
          <span>Ours / A1 D256 / FFHQ-64</span>
        </a>
        <div class="home-feature-copy">
          <p class="section-overline">01 / Image generation</p>
          <h3><a href={withBase('projects/' + project.slug + '/')}>{project.title}</a></h3>
          <p>{project.contribution}</p>
          {project.featuredResult && <div class="home-result"><strong>{project.featuredResult.relativeCost}</strong><span>reported FID cost · CIFAR-10 D192 · matched 100k<br />STRONG criterion satisfied</span></div>}
          <a class="text-link" href={withBase('projects/' + project.slug + '/')}>Read the study <span aria-hidden="true">↗</span></a>
        </div>
      </article>)}
    </section>
    <p class="home-footnote">The headline CIFAR-10 result is separate from the displayed FFHQ-64 A1 sample grid. The linked checkpoint report supplies the prior-work trajectories.</p>
  </div>
</Base>
