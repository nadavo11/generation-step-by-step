---
import Base from '../../layouts/Base.astro';
import ExperimentStatus from '../../components/ExperimentStatus.astro';
import MetricTable from '../../components/MetricTable.astro';
import QualitativeSamples from '../../components/QualitativeSamples.astro';
import SpectralExplorer from '../../components/SpectralExplorer.astro';
import TrajectoryExplorer from '../../components/TrajectoryExplorer.astro';
import Caveats from '../../components/Caveats.astro';
import NextExperiments from '../../components/NextExperiments.astro';
import { projects } from '../../data/projects';
import type { Project } from '../../types';
import { withBase } from '../../utils/paths';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props { project: Project; }
const { project } = Astro.props;
const featured = project.featuredResult;
const heroFigure = project.figures[0];
---
<Base title={project.title + ' | Research projects'} description={project.contribution}>
  <article>
    <header class="project-hero shell">
      <div class="hero-meta"><span>Research study / 01</span><span>Image generation · frequency ordering</span></div>
      <div class="hero-grid">
        <div class="hero-intro">
          <h1>{project.title}</h1>
          <p class="hero-subtitle">Can generation reveal an image as its frequencies arrive?</p>
        </div>
        {featured && <div class="hero-result" aria-label="Headline reported result">
          <p class="result-context">{featured.training} <span>·</span> {featured.control} → {featured.variant}</p>
          <div class="hero-metric"><strong>{featured.relativeCost}</strong><span>FID cost<br />relative to control</span></div>
          <p class="hero-criterion"><span class="criterion-dot" aria-hidden="true"></span>{featured.criterion}</p>
          <p class="hero-result-source">Researcher-supplied result · evidence status below.</p>
        </div>}
        <div class="hero-deck"><p class="hero-contribution">{project.contribution}</p><a class="text-link" href="#question">Explore the study <span aria-hidden="true">↓</span></a></div>
      </div>
      {heroFigure && <figure class="hero-figure">
        <a href={withBase(heroFigure.src)} target="_blank" rel="noopener" aria-label="Open full DCTdiff trajectory figure"><img src={withBase(heroFigure.src)} alt={heroFigure.alt} fetchpriority="high" /></a>
        <figcaption><span>Context image / completed checkpoint audit</span><span>DCTdiff on FFHQ-128. This trajectory is not an A0/A1 comparison.</span></figcaption>
      </figure>}
    </header>

    <div class="shell story-grid">
      <aside class="story-nav" aria-label="On this page">
        <span class="nav-label">On this page</span>
        <a href="#question">The question</a>
        <a href="#design">Experimental design</a>
        <a href="#result">Main result</a>
        <a href="#visuals">Visual evidence</a>
        <a href="#instruments">Explore all trajectories</a>
        <a href="#caveat">Caveat</a>
        <a href="#interpretation">Interpretation</a>
        <a href="#status">Status and next steps</a>
      </aside>

      <div class="story-content">
        <section id="question" class="story-section question-section">
          <p class="section-overline">The question</p>
          <h2>When is an intermediate image actually useful?</h2>
          <p class="section-lead">{project.question}</p>
          <div class="question-columns">
            <div><h3>Why it matters</h3><p>{project.motivation}</p></div>
            <div><h3>What the audit measures</h3><p>The decoded image is compared with its own final sample band by band. This reveals when a sample becomes decided; it does not measure realism.</p></div>
          </div>
        </section>

        <section id="design" class="story-section design-section">
          <p class="section-overline">Experimental design</p>
          <h2>One change, matched training.</h2>
          {featured && <div class="design-comparison">
            <div class="design-arm"><span class="arm-id">A0</span><div><h3>Joint control</h3><p>Control arm in the matched 100k comparison.</p></div></div>
            <div class="design-divider" aria-hidden="true"><span>compared with</span></div>
            <div class="design-arm"><span class="arm-id">A1</span><div><h3>Next-frequency</h3><p>Frequency-autoregressive variant in the matched 100k comparison.</p></div></div>
          </div>}
        </section>

        {featured && <section id="result" class="story-section result-section">
          <div class="section-heading-row"><p class="section-overline">Main quantitative result</p><span class="evidence-tag">Researcher reported</span></div>
          <h2>A1 holds up at the matched comparison.</h2>
          <div class="result-composition">
            <div class="result-number"><strong>{featured.relativeCost}</strong><span>relative FID cost</span></div>
            <div class="result-reading"><p>At 100k, <strong>{featured.variant}</strong> meets the pre-registered <strong>STRONG</strong> criterion against <strong>{featured.control}</strong>.</p><span>Approximate relative cost, not a newly measured FID on this site.</span></div>
          </div>
          <div class="comparison-table-wrap" role="region" aria-label="A0 and A1 comparison" tabindex="0"><table class="comparison-table">
            <thead><tr><th scope="col">Arm</th><th scope="col">Matched setting</th><th scope="col">Reported outcome</th></tr></thead>
            <tbody><tr><th scope="row">A0 · joint control</th><td data-label="Matched setting">100k</td><td data-label="Reported outcome">Reference for relative FID cost</td></tr><tr><th scope="row">A1 · next-frequency</th><td data-label="Matched setting">100k</td><td data-label="Reported outcome">≈5% FID cost; STRONG satisfied</td></tr></tbody>
          </table></div>
          <p class="result-footnote">{featured.provenance}</p>
        </section>}

        <section id="visuals" class="story-section visuals-section">
          <div class="section-heading-row"><p class="section-overline">Qualitative evidence</p><span class="evidence-tag">Completed checkpoint audit</span></div>
          <h2>Watch the image take shape.</h2>
          <p class="section-lead">The available figures show trajectories from official DCTdiff, FAR, D-AR, FlexVAR, VAR, and DetailFlow checkpoints. They provide context for streaming previews; they are not A0/A1 samples.</p>
          <QualitativeSamples findings={project.qualitative} figures={project.figures} />
          <a class="text-link" href={withBase('report/')}>Open every strip and frequency plot in the source report <span aria-hidden="true">↗</span></a>
        </section>

        <section id="instruments" class="story-section instruments-section">
          <div class="section-heading-row"><p class="section-overline">Interactive audit instruments</p><span class="evidence-tag">Completed checkpoint audit</span></div>
          <h2>Inspect the full evidence.</h2>
          <p class="section-lead">Switch between a model’s predicted image and the state carried to its next step. Compare when each frequency band settles across every DCTdiff and FAR checkpoint, then inspect all sampled datasets and model sizes.</p>
          <SpectralExplorer />
          <TrajectoryExplorer />
          <a class="text-link" href={withBase('report/')}>Read methods, checkpoint sources, and the original report <span aria-hidden="true">↗</span></a>
        </section>

        {featured && <section id="caveat" class="story-section caveat-section">
          <p class="section-overline">Qualitative caveat</p>
          <div class="caveat-grid"><span class="caveat-mark" aria-hidden="true">∿</span><div><h2>A specific artifact remains.</h2><p class="caveat-primary">{featured.caveat}</p><p>The reported STRONG result and this failure mode should be read together. A G2 sample figure was not supplied, so the issue is stated without a fabricated visual.</p></div></div>
        </section>}

        <section id="interpretation" class="story-section interpretation-section">
          <p class="section-overline">Scientific interpretation / context</p>
          <h2>What the trajectory audit shows.</h2>
          <p class="section-lead">{project.verdict}</p>
          <div class="interpretation-body"><p>{project.interpretation}</p><p>This completed prior-work audit supports the streaming question; it does not establish the separate A0/A1 quantitative result.</p></div>
          <MetricTable rows={project.results} />
          <details class="technical-detail"><summary>Published ImageNet-256 methods in the report <span aria-hidden="true">+</span></summary><p>These paper and checkpoint FID figures are cited, not re-measured under a controlled ranking.</p><MetricTable rows={project.relatedMethods} /></details>
        </section>

        <section id="status" class="story-section status-section">
          <p class="section-overline">Current status</p>
          <h2>What is established, and what is still open.</h2>
          <div class="status-rows"><div><ExperimentStatus status="completed" /><p>The official checkpoint trajectory audit and its figures are complete and accessible.</p></div><div><ExperimentStatus status="reported" /><p>The A0/A1 matched-100k result and STRONG verdict are supplied by the researcher; exact FID values and A0/A1 samples are not available on this page.</p></div><div><ExperimentStatus status="proposed" /><p>Controlled FID re-evaluation and a closer G2 artifact check remain future work; no later training outcome is asserted here.</p></div></div>
          <details class="technical-detail audit-caveats"><summary>Limits of the checkpoint audit <span aria-hidden="true">+</span></summary><Caveats items={project.caveats} /></details>
        </section>

        <section id="next" class="story-section next-section">
          <p class="section-overline">Next experiment</p>
          <h2>Resolve the artifact. Report the exact comparison.</h2>
          <p class="section-lead">Revisit the single-token G2 checkerboard in seeds 5 and 7, and publish the exact matched A0/A1 FID values with the evaluation protocol.</p>
          <details class="technical-detail"><summary>Other checks suggested by the audit <span aria-hidden="true">+</span></summary><NextExperiments items={project.nextExperiments} /></details>
          <div class="end-note"><span>Source boundary</span><p>{project.sourceNote} The A0/A1 and G2 statements above come from the researcher’s redesign brief and are not in that report.</p><a class="text-link" href={withBase('report/')}>Read the source report <span aria-hidden="true">↗</span></a></div>
        </section>
      </div>
    </div>
  </article>
</Base>
